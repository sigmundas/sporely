  "rules": {
   "accepted_authorship_disagrees": "the accepted name keys differ (canonical name plus authorship)",
   "infraspecific_rank": "both accepted usages are infraspecific (subspecies, variety, form)",
   "non_species_rank": "either source's accepted usage has a rank other than species or an infraspecific rank (subspecies, variety, form)",
   "only_accepted_name_variant": "every shared synonym is the accepted name itself under another authorship or a spelling variant of it: same word count, hyphens removed, first word equal (unless uninomial) and every word within Levenshtein distance 2 of the accepted name's word",
   "only_ined": "every shared synonym's authorship carries the word 'ined'",
   "only_invalid_name": "every shared synonym's authorship carries nom. nud., nom. inval., nom. herb. or nom. illeg. (and not 'ined')",
   "only_mixed_weak": "every shared synonym is one of the weak kinds above, but not all the same kind",
   "only_unauthored": "every shared synonym has an empty authorship, so the match is on the name alone",
   "ordinary": "species rank, agreeing accepted names, and at least one ordinary shared synonym (none of the weak kinds above); not low overlap",
   "single_shared_synonym_low_overlap": "exactly one ordinary shared synonym while each source publishes at least 5 synonyms"
  }
