/database/reference_data/sources/

# COL source archives: retain manifests/reports, ignore only large/transient bytes
/database/taxonomy/sources/col_xr/*/archive.zip
/database/taxonomy/sources/col_xr/*/.staging/
/database/taxonomy/sources/col_xr/*/extracted/
/database/taxonomy/sources/col_xr/*/.quarantine/archive.zip
/database/taxonomy/sources/col_xr/*/*.part
/database/taxonomy/sources/col_xr/*/*.partial

# NorTaxa source archives: retain requests/manifests/reports, ignore raw bytes
/database/taxonomy/sources/nortaxa/*/archive.zip
/database/taxonomy/sources/nortaxa/*/.staging/
/database/taxonomy/sources/nortaxa/*/.quarantine/
/database/taxonomy/sources/nortaxa/*/extracted/
/database/taxonomy/sources/nortaxa/*/*.part
/database/taxonomy/sources/nortaxa/*/*.partial
# Runtime flock sentinel: intentionally persistent, never committed
/database/taxonomy/sources/nortaxa/*/.nortaxa-acquisition.lock

# Stage 3A shared-compiler candidate outputs and normalized-source scratch.
# The canonical identity registry lives as an ordered shard directory at
# database/taxonomy/registry/canonical/ — that directory (its manifest.json
# and part-*.jsonl shards) is durable, version-controlled, and generated by
# a maintainer-authored promotion. Every OTHER registry file under
# registry/ (dry runs, experiments, staging) stays local.
/database/taxonomy/normalized/
/database/taxonomy/releases/
/database/taxonomy/registry/*.jsonl
/database/taxonomy/registry/*.tmp
!/database/taxonomy/registry/canonical/
!/database/taxonomy/registry/canonical/**
